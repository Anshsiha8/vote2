# GEMINI_API_KEY: Not used in this non-AI application
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Configurable Public Application Base URL
# Controls the domain encoded in audience QR codes and shareable links.
# In production, if unset, Campus Vote automatically uses the live browser origin (https://<your-domain>).
# In local development, it defaults to the local origin (http://localhost:3000).
VITE_APP_URL="https://campusvote.example.com"
APP_URL="https://campusvote.example.com"

# Supabase configuration (Optional: Campus Vote includes built-in live local storage sync if not provided)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

